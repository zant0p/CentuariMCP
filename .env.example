# Printer Configuration
PRINTER_IP=192.168.1.41
PRINTER_PORT=3030
MAINBOARD_ID=000000000001d354

# Safety Limits
MAX_NOZZLE_TEMP=300
MAX_BED_TEMP=110
COMMAND_RATE_LIMIT_MS=2000

# Logging
LOG_LEVEL=INFO
LOG_FILE=centauri-mcp.log

# WebSocket Connection
WEBSOCKET_URL=ws://{PRINTER_IP}:{PRINTER_PORT}/websocket
WEBSOCKET_TIMEOUT=30

# Video Stream
VIDEO_STREAM_URL=http://{PRINTER_IP}:3031/video
VIDEO_ENABLED=true

# MCP Server
MCP_SERVER_NAME=centauri-mcp
MCP_SERVER_VERSION=0.1.0
